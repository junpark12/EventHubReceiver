# Required
EVENTHUB_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<policy_name>;SharedAccessKey=<key>;EntityPath=<eventhub_name>
EVENTHUB_NAME=auditlog

# Optional
EVENTHUB_CONSUMER_GROUP=diag-check
OUTPUT_DIR=./output
MAX_EVENTS=100
RUN_DURATION_SECONDS=60
MAX_WAIT_TIME_SECONDS=10
STARTING_POSITION=-1
# STARTING_POSITION options:
# -1      => earliest available event
# @latest => only new events from now
